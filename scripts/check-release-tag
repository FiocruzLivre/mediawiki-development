#!/usr/bin/env bash
set -Eeuo pipefail

tag="${1:?Missing release tag}"
version="${2:?Missing MediaWiki version}"

if [[ ! "$tag" =~ ^([0-9]+\.[0-9]+\.[0-9]+)-r([1-9][0-9]*)$ ||
    "${BASH_REMATCH[1]:-}" != "$version" ]]; then
    echo "Release tag '$tag' must match MediaWiki $version with image revision (e.g. ${version}-r1)" >&2
    exit 1
fi
